      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ds-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (ins, cls, ip) (up{job=\"node\",ins!=\"\",cls=~\"$cls\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ds-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (ins, pkgs) (node_reboot_required{cls=~\"$cls\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ds-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (ins, running, installed) (node_kernel_stale{cls=~\"$cls\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ds-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (ins) (time() - node_boot_time_seconds{cls=~\"$cls\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ds-prometheus"
          },
          "editorMode": "code",
          "expr": "100 - avg by (ins) (rate(node_cpu_seconds_total{mode=\"idle\",cls=~\"$cls\"}[5m])) * 100",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ds-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (ins) (100 * (1 - node_memory_MemAvailable_bytes{cls=~\"$cls\"} / node_memory_MemTotal_bytes{cls=~\"$cls\"}))",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ds-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (ins) (100 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\",cls=~\"$cls\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\",cls=~\"$cls\"} * 100)",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "G"
        }
      ],
